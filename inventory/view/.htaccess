<ifModule mod_headers.c>
	# YEAR
	<filesMatch ".(ico|gif|jpg|jpeg|png|flv|pdf)$">
	  Header set Cache-Control "max-age=29030400"
	</filesMatch>
	# WEEK
	<filesMatch ".(js|css|swf)$">
	  Header set Cache-Control "max-age=604800"
	</filesMatch>
	# 45 MIN
	<filesMatch ".(html|htm|txt|php)$">
	  Header set Cache-Control "max-age=2700"
	</filesMatch>
</ifModule>
<ifModule mod_gzip.c>
mod_gzip_on Yes
mod_gzip_dechunk Yes
mod_gzip_item_include file .(html?|txt|css|js|php|pl)$
mod_gzip_item_include handler ^cgi-script$
mod_gzip_item_include mime ^text/.*
mod_gzip_item_include mime ^application/x-javascript.*
mod_gzip_item_exclude mime ^image/.*
mod_gzip_item_exclude rspheader ^Content-Encoding:.*gzip.*
</ifModule>
<ifmodule mod_deflate.c>
#AddOutputFilterByType DEFLATE text/text text/html text/plain text/xml text/x-javascript application/javascript
#AddHandler application/x-httpd-php56 .php
</ifmodule>
<IfModule mod_rewrite.c>
	RewriteEngine on
	#RewriteCond %{HTTP_HOST} !^www\.(.*)$ [NC]
	#RewriteRule ^(.*)$ http://www.%{HTTP_HOST}/sw/$1 [R=301,L]
	Options -Indexes +FollowSymLinks -MultiViews	

	RewriteRule ^solid_production_sticker_common_print/([^/]*)/([0-9]+)$ solid_production_sticker_common_print.php?id=$1&rtype=$2 [L]
	RewriteRule ^grn_edit/([^/]*)$ grn_add.php?id=$1 [L]
	RewriteRule ^opening_sticker_common_print/([^/]*)$ opening_sticker_common_print.php?id=$1 [L]
	RewriteRule ^stock_general_sticker_common_print/([^/]*)$ stock_general_sticker_common_print.php?id=$1 [L]
	
	RewriteRule ^stock_transfer_edit/([^/]*)$ stock_transfer.php?id=$1 [L]
	RewriteRule ^grn_view/([^/]*)$ grn_view.php?id=$1 [L]
	RewriteRule ^grn_sticker_print/([^/]*)$ grn_sticker_print.php?id=$1 [L]	
	RewriteRule ^grn_sticker_common_print/([^/]*)$ grn_sticker_common_print.php?id=$1 [L]	
	RewriteRule ^grn_creative_sticker_print/([^/]*)$ grn_creative_sticker_print.php?id=$1 [L]	
	RewriteRule ^grn_add_job/([^/]*)$ grn_add.php?id=$1 [L]
	RewriteRule ^grn_add_reprocess_job/([^/]*)$ grn_add.php?id=$1 [L]
	RewriteRule ^grn_add_po/([^/]*)$ grn_add.php?id=$1 [L]
	RewriteRule ^paking_edit/([^/]*)$ paking_add.php?id=$1 [L]
	RewriteRule ^paking_add_sin/([^/]*)/([0-9]+)$ paking_add.php?cust_id=$1&sotrn_id=$2 [L]
	RewriteRule ^grn_stock_transfer/([^/]*)$ grn_add.php?id=$1 [L]
	RewriteRule ^grn_add_returnable/([^/]*)$ grn_add.php?id=$1 [L]
	RewriteRule ^production_store_release/([^/]*)$ production_store_release.php?id=$1 [L]
	RewriteRule ^production_return_material/([^/]*)/([0-9]+)$ production_return_material.php?release_id=$1&release_type=$2 [L]
	
	RewriteRule ^returnable_channal_update/([^/]*)$ returnable_channal_add.php?id=$1 [L]
	RewriteRule ^store_material_request/([^/]*)$ store_material_request.php?id=$1 [L]
	RewriteRule ^category_wise_min_max/([^/]*)$ category_wise_min_max.php?product_category=$1 [L]
	
	RewriteRule ^non_returnable_channal_list returnable_channal_list.php?id=$1 [L]
	RewriteRule ^non_returnable_channal_add returnable_channal_add.php?id=$1 [L]
	RewriteRule ^non_returnable_channal_update/([^/]*)$ returnable_channal_add.php?id=$1 [L]
	RewriteRule ^stock_general_edit/([^/]*)$ stock_general_add.php?id=$1 [L]
	RewriteRule ^label_printing/([^/]*)$ label_printing.php?id=$1 [L]
	RewriteRule ^label_printing_without_ce_ecrep/([^/]*)$ label_printing_without_ce_ecrep.php?id=$1 [L]

	RewriteRule ^workorder_transfer_edit/([^/]*)$ workorder_transfer.php?id=$1 [L]

	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_FILENAME}\.php -f
	RewriteRule ^(.*)$ $1.php
</ifModule>
<ifModule mod_headers.c>
# YEAR
<filesMatch ".(ico|gif|jpg|jpeg|png|flv|pdf)$">
Header set Cache-Control "max-age=29030400"
</filesMatch>
# WEEK
<filesMatch ".(js|css|swf)$">
Header set Cache-Control "max-age=604800"
</filesMatch>
# 45 MIN
<filesMatch ".(html|htm|txt|php)$">
Header set Cache-Control "max-age=2700"
</filesMatch>
</ifModule>
<ifModule mod_gzip.c>
mod_gzip_on Yes
mod_gzip_dechunk Yes
mod_gzip_item_include file .(html?|txt|css|js|php|pl)$
mod_gzip_item_include handler ^cgi-script$
mod_gzip_item_include mime ^text/.*
mod_gzip_item_include mime ^application/x-javascript.*
mod_gzip_item_exclude mime ^image/.*
mod_gzip_item_exclude rspheader ^Content-Encoding:.*gzip.*
</ifModule>
<ifmodule mod_deflate.c>
#AddOutputFilterByType DEFLATE text/text text/html text/plain text/xml text/x-javascript application/javascript
#AddHandler application/x-httpd-php56 .php
</ifmodule>
<IfModule mod_rewrite.c>

RewriteEngine on
#RewriteCond %{HTTP_HOST} !^www\.(.*)$ [NC]
#RewriteRule ^(.*)$ http://www.%{HTTP_HOST}/sw/$1 [R=301,L]
Options -Indexes +FollowSymLinks -MultiViews


#Inquiry links
RewriteRule ^inquiry_list/([^/]*)$ inquiry_list.php?user_id=$1 [L] 
RewriteRule ^inquiry_edit/([^/]*)$ inquiry_add.php?id=$1 [L]
RewriteRule ^inq_to_quot/([^/]*)$ quotation_add.php?id=$1 [L] 
RewriteRule ^inq_to_quot/([^/]*)/([^/]*)$ quotation_add.php?id=$1&task_id=$2 [L] 
RewriteRule ^inquiry_view/([^/]*)$ inquiry_view.php?id=$1 [L]
RewriteRule ^inquiry_review/([^/]*)$ inquiry_review.php?id=$1 [L]
RewriteRule ^inquiry_list/([^/]*)/([^/]*)$ inquiry_list.php?user_id=$1&stage_id=$2 [L]
RewriteRule ^inquiry_list_source/([^/]*)/([^/]*)$ inquiry_list.php?user_id=$1&source_id=$2 [L]
RewriteRule ^target_report_details/([^/]*)/([^/]*)/([^/]*)$ target_report_details.php?customer=$1&st_date=$2&end_date=$3 [L]
RewriteRule ^inquiry_list_flt_source/([^/]*)/([^/]*)/([^/]*)$ inquiry_list.php?source_id=$1&start_date=$2&end_date=$3 [L]
RewriteRule ^inquiry_list_flt_prod/([^/]*)/([^/]*)/([^/]*)/([^/]*)/([^/]*)$ inquiry_list.php?product_id=$1&category_id=$2&assign_user_id=$3&start_date=$4&end_date=$5 [L]
RewriteRule ^inquiry_list_flt_funnel/([^/]*)$ inquiry_list.php?stage_id=$1 [L]
RewriteRule ^inquiry_list_flt_state/([^/]*)/([^/]*)/([^/]*)/([^/]*)$ inquiry_list.php?stateid=$1&assign_user_id=$2&start_date=$3&end_date=$4 [L]
RewriteRule ^inquiry_list_flt_city/([^/]*)/([^/]*)/([^/]*)/([^/]*)/([^/]*)$ inquiry_list.php?stateid=$1&cityid=$2&assign_user_id=$3&start_date=$4&end_date=$5 [L]
RewriteRule ^inquiry_list_usr_stage/([^/]*)/([^/]*)$ inquiry_list.php?assign_user_id=$1&stage_id=$2 [L]
RewriteRule ^crm_stage_users/([^/]*)/([^/]*)/([^/]*)$ crm_stage_users.php?opp_id=$1&start_date=$2&end_date=$3 [L]
RewriteRule ^crm_city_users/([^/]*)$ crm_city_users.php?opp_id=$1 [L]
RewriteRule ^inquiry_list_flt_objection/([^/]*)/([^/]*)/([^/]*)/([^/]*)$ inquiry_list.php?month=$1&assign_user_id=$2&start_date=$3&end_date=$4 [L]
RewriteRule ^inquiry_list_flt_inq/([^/]*)/([^/]*)/([^/]*)/([^/]*)/([^/]*)$ inquiry_list.php?opp_id=$1&category_id=$2&assign_user_id=$3&start_date=$4&end_date=$5 [L]
RewriteRule ^inquiry_list_stage_lost/([^/]*)/([^/]*)/([^/]*)$ inquiry_list.php?stage_id=$1&start_date=$2&end_date=$3 [L]
RewriteRule ^inquiry_list_sales_stage/([^/]*)/([^/]*)/([^/]*)$ inquiry_list.php?sales_stage_id=$1&start_date=$2&end_date=$3 [L]
RewriteRule ^inquiry_list_sales_stage_category/([^/]*)/([^/]*)/([^/]*)/([^/]*)$ inquiry_list.php?sales_stage_cat_id=$1&assign_user_id=$2&start_date=$3&end_date=$4 [L]

# Task links
RewriteRule ^task_add/([^/]*)/([0-9]+)$ task_add.php?id=$1&quotation_id=$2 [L]
RewriteRule ^task_add/([^/]*)$ task_add.php?id=$1 [L]
RewriteRule ^task_flp/([^/]*)$ task_add.php?id=$1 [L]
RewriteRule ^task_edit/([^/]*)$ task_add.php?id=$1 [L] 
RewriteRule ^pending_task_list/([^/]*)$ pending_task_list.php?id=$1 [L]
RewriteRule ^pending_task_list/([^/]*)/([0-9]+)$ pending_task_list.php?id=$1&userid=$2 [L]
RewriteRule ^pending_task_list_one/([^/]*)$ pending_task_list_one.php?id=$1 [L]
RewriteRule ^pending_task_list_one/([^/]*)/([0-9]+)$ pending_task_list_one.php?id=$1&userid=$2 [L]

RewriteRule ^general_task_add/([^/]*)$ general_task_add.php?id=$1 [L]
RewriteRule ^general_task_flp/([^/]*)$ general_task_add.php?id=$1 [L]
RewriteRule ^general_task_edit/([^/]*)$ general_task_add.php?id=$1 [L]
RewriteRule ^general_pending_task_list/([^/]*)$ general_pending_task_list.php?id=$1 [L]
RewriteRule ^general_pending_task_list/([^/]*)/([0-9]+)$ general_pending_task_list.php?id=$1&userid=$2 [L]
RewriteRule ^general_pending_task_list_one/([^/]*)$ general_pending_task_list_one.php?id=$1 [L]
RewriteRule ^general_pending_task_list_one/([^/]*)/([0-9]+)$ general_pending_task_list_one.php?id=$1&userid=$2 [L]

# Appointment Links
RewriteRule ^appointment_add/([^/]*)$ appointment_add.php?id=$1 [L]
RewriteRule ^appointment_edit/([^/]*)$ appointment_add.php?id=$1 [L] 

# Quotation Links
RewriteRule ^quotation_revise/([^/]*)$ quotation_add.php?id=$1 [L] 
RewriteRule ^quotation_edit/([^/]*)$ quotation_add.php?id=$1 [L] 
RewriteRule ^quotation_template2_print/([^/]*)$ quotation_template2_print.php?id=$1 [L]
RewriteRule ^quotation_print/([^/]*)$ quotation_print.php?id=$1 [L]
RewriteRule ^quotation_pdf_print/([^/]*)$ quotation_pdf_print.php?&type=$1 [L]
RewriteRule ^quotation_vendorprint/([0-9]+)/([^/]*)$ quotation_vendorprint.php?id=$1&poid=$2 [L]
RewriteRule ^po_quotation_add/([^/]*)$ po_quotation_add.php?id=$1 [L]
RewriteRule ^po_quotation_approve/([^/]*)$ po_quotation_approve.php?id=$1 [L]
RewriteRule ^po_quotation_vendor_list/([^/]*)$ po_quotation_vendor_list.php?id=$1 [L]
RewriteRule ^po_quotation_edit/([0-9]+)/([^/]*)$ po_quotation_add.php?id=$1&poid=$2 [L]


# Order Confirmation links
RewriteRule ^order_confirm_list/([^/]*)$ order_confirm_list.php?id=$1 [L]

# Sales Order Links
RewriteRule ^salesorderedit/([^/]*)$ sales_order.php?id=$1 [L]
RewriteRule ^order_review_form/([^/]*)$ order_review_form.php?id=$1 [L]
RewriteRule ^sales_order_emend/([^/]*)$ sales_order.php?id=$1 [L]
RewriteRule ^salesorder_quotation/([^/]*)$ sales_order.php?id=$1 [L]
RewriteRule ^sales_order_stage/([^/]*)$ sales_order_stage.php?id=$1 [L]
RewriteRule ^sales_order_print/([^/]*)$ sales_order_print.php?id=$1 [L]
RewriteRule ^sales_order_tracking/([^/]*)$ sales_order_tracking.php?id=$1 [L]

# Forcast Links
RewriteRule ^forecast_byuser_pro_edit/([^/]*)$ forecast_byuser_pro_add.php?id=$1 [L]
RewriteRule ^forecast_byuser_edit/([^/]*)$ forecast_byuser_add.php?id=$1 [L]
RewriteRule ^forecast_user_edit/([^/]*)$ forecast_user_add.php?id=$1 [L]
RewriteRule ^forecast_user_copy/([^/]*)$ forecast_user_add.php?id=$1 [L]
RewriteRule ^forecast_view/([^/]*)$ forecast_view.php?id=$1 [L]
RewriteRule ^forecast_edit/([^/]*)$ forecast_add.php?id=$1 [L]

# CRM Master Links
RewriteRule ^annexure_detail_edit/([^/]*)$ annexure_detail.php?id=$1 [L] 
RewriteRule ^terms_edit/([^/]*)$ terms_add.php?id=$1 [L]
RewriteRule ^customeraddedit/([^/]*)$ customer.php?id=$1 [L]
RewriteRule ^customeraddedit_user/([^/]*)$ customer_user.php?id=$1 [L]

# CRM Order Acceptance
RewriteRule ^order_acceptance_print/([^/]*)$ order_acceptance_print.php?id=$1 [L]

# CRM Project Assign
RewriteRule ^project_assign_edit/([^/]*)$ project_assign.php?id=$1 [L]

#CRM Proforma Invoice
RewriteRule ^proformaedit/([^/]*)$ proforma.php?id=$1 [L]
RewriteRule ^proformareceipt/([^/]*)/([0-9]+)$ proformareceipt.php?id=$1&printstatus=$2 [L]
RewriteRule ^proformareceipt/([^/]*)$ proformareceipt.php?id=$1 [L]

RewriteRule ^value_target_details/([^/]*)/([0-9]+)$ view_value_wise_target_details.php?id=$1&id1=$2 [L]
RewriteRule ^product_target_details/([^/]*)$ product_vise_target_details.php?id=$1 [L]

RewriteRule ^daily_activity_edit/([^/]*)$ daily_activity_add.php?id=$1 [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php
</ifModule>
<ifModule mod_headers.c>
	# YEAR
	<filesMatch ".(ico|gif|jpg|jpeg|png|flv|pdf)$">
	  Header set Cache-Control "max-age=29030400"
	</filesMatch>
	# WEEK
	<filesMatch ".(js|css|swf)$">
	  Header set Cache-Control "max-age=604800"
	</filesMatch>
	# 45 MIN
	<filesMatch ".(html|htm|txt|php)$">
	  Header set Cache-Control "max-age=2700"
	</filesMatch>
</ifModule>
<ifModule mod_gzip.c>
mod_gzip_on Yes
mod_gzip_dechunk Yes
mod_gzip_item_include file .(html?|txt|css|js|php|pl)$
mod_gzip_item_include handler ^cgi-script$
mod_gzip_item_include mime ^text/.*
mod_gzip_item_include mime ^application/x-javascript.*
mod_gzip_item_exclude mime ^image/.*
mod_gzip_item_exclude rspheader ^Content-Encoding:.*gzip.*
</ifModule>
<ifmodule mod_deflate.c>
#AddOutputFilterByType DEFLATE text/text text/html text/plain text/xml text/x-javascript application/javascript
#AddHandler application/x-httpd-php56 .php
</ifmodule>
<IfModule mod_rewrite.c>
	RewriteEngine on
	#RewriteCond %{HTTP_HOST} !^www\.(.*)$ [NC]
	#RewriteRule ^(.*)$ http://www.%{HTTP_HOST}/sw/$1 [R=301,L]
	Options -Indexes +FollowSymLinks -MultiViews
	
	RewriteRule ^hrms_attendance_tools_edit/([^/]*)$ hrms_attendance_tools_add.php?id=$1 [L]
	RewriteRule ^hrms_employee_edit/([^/]*)$ hrms_employee_add.php?id=$1 [L]
	RewriteRule ^holiday_edit/([^/]*)$ holiday_add.php?id=$1 [L]
	RewriteRule ^leave_type_edit/([^/]*)$ hrms_leave_type_add.php?id=$1 [L]
	RewriteRule ^hrms_leave_application_edit/([^/]*)$ hrms_leave_application_add.php?id=$1 [L]
	RewriteRule ^hrms_leave_allocation_edit/([^/]*)$ hrms_leave_allocation_add.php?id=$1 [L]
	RewriteRule ^hrms_comp_leave_request_edit/([^/]*)$ hrms_comp_leave_request_add.php?id=$1 [L]
	RewriteRule ^hrms_leave_block_edit/([^/]*)$ hrms_leave_block_add.php?id=$1 [L]
	RewriteRule ^hrms_attendance_edit/([^/]*)$ hrms_attendance_add.php?id=$1 [L]
	RewriteRule ^hrms_attendance_request_edit/([^/]*)$ hrms_attendance_request_add.php?id=$1 [L]
	RewriteRule ^hrms_settings_edit/([^/]*)$ hrms_settings_add.php?id=$1 [L]
	RewriteRule ^hrms_email_template_edit/([^/]*)$ hrms_email_template_add.php?id=$1 [L]
	RewriteRule ^hrms_sms_template_edit/([^/]*)$ hrms_sms_template_add.php?id=$1 [L]
	RewriteRule ^hrms_employee_advance_edit/([^/]*)$ hrms_employee_advance_add.php?id=$1 [L]
	RewriteRule ^hrms_expense_claim_edit/([^/]*)$ hrms_expense_claim_add.php?id=$1 [L]
	RewriteRule ^hrms_employee_separation_template_edit/([^/]*)$ hrms_employee_separation_template_add.php?id=$1 [L]
	RewriteRule ^hrms_employee_onboarding_template_edit/([^/]*)$ hrms_employee_onboarding_template_add.php?id=$1 [L]
	RewriteRule ^hrms_employee_separation_edit/([^/]*)$ hrms_employee_separation_add.php?id=$1 [L]
	RewriteRule ^hrms_employee_onboarding_edit/([^/]*)$ hrms_employee_onboarding_add.php?id=$1 [L]
	RewriteRule ^hrms_daily_work_summary_group_edit/([^/]*)$ hrms_daily_work_summary_group_add.php?id=$1 [L]
	RewriteRule ^hrms_employee_skill_map_edit/([^/]*)$ hrms_employee_skill_map_add.php?id=$1 [L]
	RewriteRule ^hrms_appraisal_template_edit/([^/]*)$ hrms_appraisal_template_add.php?id=$1 [L]
	RewriteRule ^hrms_energy_point_rule_edit/([^/]*)$ hrms_energy_point_rule_add.php?id=$1 [L]

	RewriteRule ^payroll_salary_component_edit/([^/]*)$ payroll_salary_component_add.php?id=$1 [L]
	RewriteRule ^payroll_salary_structure_edit/([^/]*)$ payroll_salary_structure_add.php?id=$1 [L]
	RewriteRule ^payroll_salary_structure_assignment_edit/([^/]*)$ payroll_salary_structure_assignment_add.php?id=$1 [L]
	RewriteRule ^payroll_entry_edit/([^/]*)$ payroll_entry_add.php?id=$1 [L]
	RewriteRule ^payroll_income_tax_slab_edit/([^/]*)$ payroll_income_tax_slab_add.php?id=$1 [L]
	RewriteRule ^payroll_emp_tax_exemption_declaration_edit/([^/]*)$ payroll_emp_tax_exemption_declaration_add.php?id=$1 [L]
	RewriteRule ^payroll_emp_exemption_proof_submission_edit/([^/]*)$ payroll_emp_exemption_proof_submission_add.php?id=$1 [L]
	RewriteRule ^payroll_additional_salary_edit/([^/]*)$ payroll_additional_salary_add.php?id=$1 [L]
	RewriteRule ^payroll_emp_benefit_application_edit/([^/]*)$ payroll_emp_benefit_application_add.php?id=$1 [L]
	RewriteRule ^payroll_emp_benefit_claim_edit/([^/]*)$ payroll_emp_benefit_claim_add.php?id=$1 [L]
	RewriteRule ^payroll_settings_edit/([^/]*)$ payroll_settings_add.php?id=$1 [L]
	
	RewriteRule ^backup/([^/]*)$ backup.php?flag=$1 [L]
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_FILENAME}\.php -f
	RewriteRule ^(.*)$ $1.php
</ifModule>